#[[
# Writes a configuration header of numerical feature definitions at configure time.
#
# qwk_generate_config_header(<file>
#     GUARD <macro>
#     FEATURES <variable...>
# )
#
# Each variable in FEATURES becomes a macro of the same name, with the value 1 if the variable is
# true and -1 otherwise. A macro with the value -1 is still defined, so that a check of the form
# ((1 / NAME) == 1) fails to compile for a name that is not defined at all instead of evaluating
# to false.
#
# The header records the SHA-256 of its definitions. The file is left untouched if its content
# is unchanged, so that a reconfigure does not cause the translation units that include it to be
# compiled again.
#
# Requires cmake/WriteIfDifferent.cmake.
#]]
function(qwk_generate_config_header _file)
    set(options)
    set(oneValueArgs GUARD)
    set(multiValueArgs FEATURES)
    cmake_parse_arguments(FUNC "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(FUNC_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR
            "qwk_generate_config_header: unknown arguments: ${FUNC_UNPARSED_ARGUMENTS}"
        )
    endif()

    if(NOT FUNC_GUARD)
        message(FATAL_ERROR "qwk_generate_config_header: GUARD is required")
    endif()

    set(_definitions)

    foreach(_item IN LISTS FUNC_FEATURES)
        if(${_item})
            string(APPEND _definitions "#define ${_item} 1\n")
        else()
            string(APPEND _definitions "#define ${_item} -1\n")
        endif()
    endforeach()

    string(SHA256 _hash "${_definitions}")

    set(_content "#ifndef ${FUNC_GUARD}
#define ${FUNC_GUARD}

// Caution: This file is generated by CMake automatically during configure.
// WARNING!!! DO NOT EDIT THIS FILE MANUALLY!!!
// ALL YOUR MODIFICATIONS HERE WILL GET LOST AFTER RE-CONFIGURING!!!

// SHA256: ${_hash}

${_definitions}
#endif // ${FUNC_GUARD}
")

    qwk_write_if_different("${_file}" "${_content}")
endfunction()
