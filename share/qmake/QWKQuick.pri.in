!defined(QMAKE_QWK_QUICK_INCLUDED, var) {
    QMAKE_QWK_QUICK_INCLUDED = 1

    include($$PWD/QWKCore.pri)

    CONFIG(debug, debug|release) {
        LIBS = $$QMAKE_QWK_LINK_PATH -l@QMAKE_QWK_QUICK_NAME_DEBUG@ $$LIBS
    } else {
        LIBS = $$QMAKE_QWK_LINK_PATH -l@QMAKE_QWK_QUICK_NAME_RELEASE@ $$LIBS
    }

    @QMAKE_QWK_QUICK_STATIC_MACRO@

    # Qt Creator's QML code model also needs the installed module metadata.
    exists($$QMAKE_QWK_INSTALL_PREFIX/qml/QWindowKit/qmldir) {
        QML_IMPORT_PATH += $$QMAKE_QWK_INSTALL_PREFIX/qml
    }
}
